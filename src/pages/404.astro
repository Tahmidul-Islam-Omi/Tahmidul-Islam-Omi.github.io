---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — Page not found">
  <section
    class="mx-auto flex min-h-[80vh] max-w-5xl flex-col items-center justify-center px-6 text-center"
  >
    <p class="font-mono text-sm text-accent-500">// error 404</p>
    <h1
      class="mt-4 text-6xl font-semibold tracking-tight text-[var(--text)] sm:text-7xl"
    >
      404
    </h1>
    <p class="mt-4 max-w-md text-lg text-[var(--text-muted)]">
      Looks like this route returned <span class="font-mono text-accent-400"
        >null</span
      >. The page you're after doesn't exist.
    </p>
    <a
      href="/"
      class="mt-8 rounded-lg bg-accent-600 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-500"
    >
      &larr; Back to home
    </a>
  </section>
</Layout>
