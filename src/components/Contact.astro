---
import SectionHeading from "./SectionHeading.astro";
import { SOCIALS } from "../config";
---

<section id="contact" class="mx-auto max-w-5xl scroll-mt-20 px-6 py-24">
  <SectionHeading num="05" title="Contact" />

  <div class="grid gap-10 md:grid-cols-2">
    <div data-reveal>
      <h3 class="text-2xl font-semibold tracking-tight text-[var(--text)]">
        Let's build something together.
      </h3>
      <p class="mt-4 leading-relaxed text-[var(--text-muted)]">
        I'm open to internships, full-time roles, and interesting
        collaborations. Drop a message or reach me directly — I'll get back to
        you soon.
      </p>

      <div class="mt-6 space-y-3 text-sm">
        {
          SOCIALS.email && (
            <a
              href={`mailto:${SOCIALS.email}`}
              class="flex items-center gap-3 text-[var(--text-muted)] transition-colors hover:text-accent-500"
            >
              <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m2 7 10 6 10-6" />
              </svg>
              {SOCIALS.email}
            </a>
          )
        }
        {
          SOCIALS.github && (
            <a href={SOCIALS.github} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-[var(--text-muted)] transition-colors hover:text-accent-500">
              <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.73.5.5 5.74.5 12.04c0 5.1 3.29 9.42 7.86 10.95.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.06-.73.08-.71.08-.71 1.17.08 1.79 1.21 1.79 1.21 1.04 1.79 2.73 1.27 3.4.97.1-.76.41-1.27.74-1.56-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.41-5.25 5.69.42.36.8 1.08.8 2.18v3.23c0 .31.21.67.8.56A11.55 11.55 0 0 0 23.5 12.04C23.5 5.74 18.27.5 12 .5Z" />
              </svg>
              GitHub
            </a>
          )
        }
        {
          SOCIALS.linkedin && (
            <a href={SOCIALS.linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-[var(--text-muted)] transition-colors hover:text-accent-500">
              <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
              </svg>
              LinkedIn
            </a>
          )
        }
      </div>
    </div>

    <!--
      Contact form via Web3Forms (free, no backend, works on static hosts).
      TODO: create a free access key at https://web3forms.com (uses your email,
      no signup) and paste it into the hidden `access_key` field below.
    -->
    <form
      id="contact-form"
      action="https://api.web3forms.com/submit"
      method="POST"
      class="space-y-4"
      data-reveal
      data-reveal-delay="120"
    >
      <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
      <input type="hidden" name="subject" value="New message from your portfolio" />
      <!-- honeypot anti-spam -->
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

      <div>
        <label for="name" class="mb-1.5 block text-sm text-[var(--text-muted)]">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          class="w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--text)] outline-none transition-colors placeholder:text-[var(--text-faint)] focus:border-accent-500"
          placeholder="Your name"
        />
      </div>
      <div>
        <label for="email" class="mb-1.5 block text-sm text-[var(--text-muted)]">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          class="w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--text)] outline-none transition-colors placeholder:text-[var(--text-faint)] focus:border-accent-500"
          placeholder="you@example.com"
        />
      </div>
      <div>
        <label for="message" class="mb-1.5 block text-sm text-[var(--text-muted)]">Message</label>
        <textarea
          id="message"
          name="message"
          rows="4"
          required
          class="w-full resize-y rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--text)] outline-none transition-colors placeholder:text-[var(--text-faint)] focus:border-accent-500"
          placeholder="Hi Tahmidul, I'd love to talk about…"></textarea>
      </div>
      <button
        type="submit"
        class="w-full rounded-lg bg-accent-600 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-500"
      >
        Send message
      </button>
      <p id="form-status" class="text-sm" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script is:inline>
  const form = document.getElementById("contact-form");
  const status = document.getElementById("form-status");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    status.textContent = "Sending…";
    status.style.color = "var(--text-muted)";
    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      if (res.ok) {
        status.textContent = "Thanks! Your message has been sent.";
        status.style.color = "#22c55e";
        form.reset();
      } else {
        throw new Error("Request failed");
      }
    } catch {
      status.textContent =
        "Something went wrong. Please email me directly instead.";
      status.style.color = "#ef4444";
    }
  });
</script>
