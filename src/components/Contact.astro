---
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
import { SOCIALS } from "../config";
---

<section id="contact" class="mx-auto max-w-5xl scroll-mt-20 px-6 py-24">
  <SectionHeading num="05" title="Contact" />

  <div class="grid gap-10 md:grid-cols-2">
    <div data-reveal>
      <h3 class="text-2xl font-semibold tracking-tight text-[var(--text)]">
        Let's build something together.
      </h3>
      <p class="mt-4 leading-relaxed text-[var(--text-muted)]">
        Whether it's an internship, a full-time or part-time role, a freelance
        project, open-source collaboration, or an idea you'd like built — I'd
        love to hear about it. Drop a message or reach me directly and I'll get
        back to you soon.
      </p>

      <div class="mt-6 space-y-3 text-sm">
        {
          SOCIALS.email && (
            <a
              href={`mailto:${SOCIALS.email}`}
              class="flex items-center gap-3 text-[var(--text-muted)] transition-colors hover:text-[var(--accent-text)]"
            >
              <Icon name="mail" class="size-5 shrink-0" />
              {SOCIALS.email}
            </a>
          )
        }
        {
          SOCIALS.github && (
            <a href={SOCIALS.github} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-[var(--text-muted)] transition-colors hover:text-[var(--accent-text)]">
              <Icon name="github" class="size-5 shrink-0" />
              GitHub
            </a>
          )
        }
        {
          SOCIALS.linkedin && (
            <a href={SOCIALS.linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-[var(--text-muted)] transition-colors hover:text-[var(--accent-text)]">
              <Icon name="linkedin" class="size-5 shrink-0" />
              LinkedIn
            </a>
          )
        }
      </div>
    </div>

    <!--
      Contact form via Web3Forms (free, no backend, works on static hosts).
      The access_key below is a public client-side key — safe to commit.
    -->
    <form
      id="contact-form"
      action="https://api.web3forms.com/submit"
      method="POST"
      class="space-y-4"
      data-reveal
      data-reveal-delay="120"
    >
      <input type="hidden" name="access_key" value="e2172b35-4218-450a-855b-dd268a97c538" />
      <input type="hidden" name="subject" value="New message from your portfolio" />
      <!-- honeypot anti-spam -->
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

      <div>
        <label for="name" class="mb-1.5 block text-sm text-[var(--text-muted)]">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          class="w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--text)] outline-none transition-colors placeholder:text-[var(--text-faint)] focus:border-accent-500"
          placeholder="Your name"
        />
      </div>
      <div>
        <label for="email" class="mb-1.5 block text-sm text-[var(--text-muted)]">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          class="w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--text)] outline-none transition-colors placeholder:text-[var(--text-faint)] focus:border-accent-500"
          placeholder="you@example.com"
        />
      </div>
      <div>
        <label for="message" class="mb-1.5 block text-sm text-[var(--text-muted)]">Message</label>
        <textarea
          id="message"
          name="message"
          rows="4"
          required
          class="w-full resize-y rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--text)] outline-none transition-colors placeholder:text-[var(--text-faint)] focus:border-accent-500"
          placeholder="Hi Tahmidul, I'd love to talk about…"></textarea>
      </div>
      <button
        type="submit"
        class="w-full rounded-lg bg-accent-600 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-700 disabled:cursor-wait disabled:opacity-70"
      >
        Send message
      </button>
      <p id="form-status" class="text-sm" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  import "../scripts/contact";
</script>
