---
import SectionHeading from "./SectionHeading.astro";
import { PROJECTS } from "../data/projects";

const featured = PROJECTS.filter((p) => p.featured);
const others = PROJECTS.filter((p) => !p.featured);
---

<section id="projects" class="mx-auto max-w-5xl scroll-mt-20 px-6 py-24">
  <SectionHeading num="03" title="Projects" />

  <!-- Featured projects: alternating image / text layout -->
  <div class="space-y-16">
    {
      featured.map((p, i) => (
        <article
          class="grid items-center gap-6 md:grid-cols-2 md:gap-10"
          data-reveal
        >
          {/* Media */}
          <div class={`group relative ${i % 2 === 1 ? "md:order-2" : ""}`}>
            <div class="overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--bg-subtle)]">
              {p.image ? (
                <img
                  src={p.image}
                  alt={`${p.name} screenshot`}
                  loading="lazy"
                  class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
              ) : (
                <div class="grid aspect-video w-full place-items-center bg-gradient-to-br from-accent-600/20 to-accent-500/5">
                  <span class="font-mono text-sm text-[var(--text-faint)]">
                    screenshot coming soon
                  </span>
                </div>
              )}
            </div>
          </div>

          {/* Text */}
          <div class={i % 2 === 1 ? "md:order-1" : ""}>
            <p class="mb-2 font-mono text-xs uppercase tracking-widest text-accent-500">
              Featured project
            </p>
            <h3 class="text-xl font-semibold tracking-tight text-[var(--text)]">
              {p.name}
            </h3>
            <p class="mt-3 leading-relaxed text-[var(--text-muted)]">
              {p.description}
            </p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {p.stack.map((tech) => (
                <li class="font-mono text-xs text-[var(--text-faint)]">
                  {tech}
                </li>
              ))}
            </ul>
            <div class="mt-5 flex items-center gap-4">
              {p.repo && (
                <a
                  href={p.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-sm font-medium text-[var(--text)] transition-colors hover:text-accent-500"
                >
                  <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 .5C5.73.5.5 5.74.5 12.04c0 5.1 3.29 9.42 7.86 10.95.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.06-.73.08-.71.08-.71 1.17.08 1.79 1.21 1.79 1.21 1.04 1.79 2.73 1.27 3.4.97.1-.76.41-1.27.74-1.56-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.41-5.25 5.69.42.36.8 1.08.8 2.18v3.23c0 .31.21.67.8.56A11.55 11.55 0 0 0 23.5 12.04C23.5 5.74 18.27.5 12 .5Z" />
                  </svg>
                  Code
                </a>
              )}
              {p.demo && (
                <a
                  href={p.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-sm font-medium text-[var(--text)] transition-colors hover:text-accent-500"
                >
                  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <path d="M15 3h6v6M10 14 21 3" />
                  </svg>
                  Live Demo
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <!-- Other projects grid -->
  {
    others.length > 0 && (
      <>
        <h3 class="mb-6 mt-20 text-center font-mono text-sm uppercase tracking-widest text-[var(--text-faint)]">
          More projects
        </h3>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {others.map((p, i) => (
            <article
              class="flex flex-col rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5 transition-all duration-300 hover:-translate-y-1 hover:border-accent-500/50"
              data-reveal
              data-reveal-delay={i * 80}
            >
              <div class="mb-3 flex items-start justify-between gap-2">
                <h4 class="font-semibold text-[var(--text)]">{p.name}</h4>
                {p.repo && (
                  <a
                    href={p.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[var(--text-muted)] transition-colors hover:text-accent-500"
                    aria-label={`${p.name} on GitHub`}
                  >
                    <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 .5C5.73.5.5 5.74.5 12.04c0 5.1 3.29 9.42 7.86 10.95.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.06-.73.08-.71.08-.71 1.17.08 1.79 1.21 1.79 1.21 1.04 1.79 2.73 1.27 3.4.97.1-.76.41-1.27.74-1.56-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.41-5.25 5.69.42.36.8 1.08.8 2.18v3.23c0 .31.21.67.8.56A11.55 11.55 0 0 0 23.5 12.04C23.5 5.74 18.27.5 12 .5Z" />
                    </svg>
                  </a>
                )}
              </div>
              <p class="flex-1 text-sm leading-relaxed text-[var(--text-muted)]">
                {p.description}
              </p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {p.stack.map((tech) => (
                  <li class="font-mono text-xs text-[var(--text-faint)]">
                    {tech}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </>
    )
  }
</section>
