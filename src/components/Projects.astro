---
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
import { PROJECTS } from "../data/projects";

const featured = PROJECTS.filter((p) => p.featured);
const others = PROJECTS.filter((p) => !p.featured);
---

<section id="projects" class="mx-auto max-w-5xl scroll-mt-20 px-6 py-24">
  <SectionHeading num="03" title="Projects" />

  <!-- Featured projects. With an image: alternating image/text layout.
       Without an image: a clean full-width text entry (no placeholder). -->
  <div class="space-y-16">
    {
      featured.map((p, i) => {
        const imageWidth = p.imageWidth ?? 1280;
        const imageHeight = p.imageHeight ?? 720;
        const portrait = imageHeight > imageWidth;

        return (
          <article
            class:list={[
              "grid items-center gap-6 md:gap-10",
              p.image && "md:grid-cols-2",
            ]}
            data-reveal
          >
            {/* Media (only when a screenshot exists) */}
            {p.image && (
              <div class:list={[
                "group relative",
                i % 2 === 1 && "md:order-2",
                portrait && "mx-auto w-full max-w-[280px]",
              ]}>
                <div class="overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--bg-subtle)]">
                  <img
                    src={p.image}
                    alt={`${p.name} screenshot`}
                    loading="lazy"
                    width={imageWidth}
                    height={imageHeight}
                    class:list={[
                      "w-full object-cover",
                      portrait
                        ? "h-auto"
                        : "aspect-video transition-transform duration-500 group-hover:scale-[1.03]",
                    ]}
                  />
                </div>
              </div>
            )}

            {/* Text */}
            <div class:list={[p.image && i % 2 === 1 && "md:order-1"]}>
              <p class="mb-2 font-mono text-xs uppercase tracking-widest text-[var(--accent-text)]">
                Featured project
              </p>
              <h3 class="text-xl font-semibold tracking-tight text-[var(--text)]">
                {p.name}
              </h3>
              <p class="mt-3 leading-relaxed text-[var(--text-muted)]">
                {p.description}
              </p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {p.stack.map((tech) => (
                  <li class="font-mono text-xs text-[var(--text-faint)]">
                    {tech}
                  </li>
                ))}
              </ul>
              <div class="mt-5 flex items-center gap-4">
                {p.repo && (
                  <a
                    href={p.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-sm font-medium text-[var(--text)] transition-colors hover:text-[var(--accent-text)]"
                  >
                    <Icon name="github" class="size-4" />
                    Code
                  </a>
                )}
                {p.demo && (
                  <a
                    href={p.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-sm font-medium text-[var(--text)] transition-colors hover:text-[var(--accent-text)]"
                  >
                    <Icon name="external-link" class="size-4" />
                    Live Demo
                  </a>
                )}
              </div>
            </div>
          </article>
        );
      })
    }
  </div>

  <!-- Other projects grid -->
  {
    others.length > 0 && (
      <>
        <h3 class="mb-6 mt-20 text-center font-mono text-sm uppercase tracking-widest text-[var(--text-faint)]">
          More projects
        </h3>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {others.map((p, i) => (
            <article
              class="flex flex-col rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5 transition-all duration-300 hover:-translate-y-1 hover:border-accent-500/50"
              data-reveal
              data-reveal-delay={i * 80}
            >
              <div class="mb-3 flex items-start justify-between gap-2">
                <h4 class="font-semibold text-[var(--text)]">{p.name}</h4>
                {p.repo && (
                  <a
                    href={p.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[var(--text-muted)] transition-colors hover:text-[var(--accent-text)]"
                    aria-label={`${p.name} on GitHub`}
                  >
                    <Icon name="github" class="size-5" />
                  </a>
                )}
              </div>
              <p class="flex-1 text-sm leading-relaxed text-[var(--text-muted)]">
                {p.description}
              </p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {p.stack.map((tech) => (
                  <li class="font-mono text-xs text-[var(--text-faint)]">
                    {tech}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </>
    )
  }
</section>
