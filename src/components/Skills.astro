---
import SectionHeading from "./SectionHeading.astro";
import { SKILL_GROUPS } from "../data/skills";
---

<section id="skills" class="mx-auto max-w-5xl scroll-mt-20 px-6 py-24">
  <SectionHeading num="02" title="Skills" />

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      SKILL_GROUPS.map((group, i) => (
        <div
          class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5 transition-colors hover:border-accent-500/40"
          data-reveal
          data-reveal-delay={i * 80}
        >
          <h3 class="mb-3 font-mono text-xs uppercase tracking-widest text-accent-500">
            {group.label}
          </h3>
          <ul class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="rounded-md border border-[var(--border)] bg-[var(--bg-subtle)] px-2.5 py-1 text-sm text-[var(--text-muted)]">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
