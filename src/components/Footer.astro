---
import Icon from "./Icon.astro";
import { SITE, SOCIALS } from "../config";
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--border)] bg-[var(--bg-subtle)]">
  <div
    class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-6 py-8 sm:flex-row"
  >
    <p class="text-sm text-[var(--text-muted)]">
      &copy; {year} {SITE.name}.
    </p>

    <div class="flex items-center gap-4 text-[var(--text-muted)]">
      {
        SOCIALS.github && (
          <a
            href={SOCIALS.github}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-[var(--accent-text)]"
            aria-label="GitHub"
          >
            <Icon name="github" class="size-5" />
          </a>
        )
      }
      {
        SOCIALS.linkedin && (
          <a
            href={SOCIALS.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-[var(--accent-text)]"
            aria-label="LinkedIn"
          >
            <Icon name="linkedin" class="size-5" />
          </a>
        )
      }
      {
        SOCIALS.email && (
          <a
            href={`mailto:${SOCIALS.email}`}
            class="transition-colors hover:text-[var(--accent-text)]"
            aria-label="Email"
          >
            <Icon name="mail" class="size-5" />
          </a>
        )
      }
    </div>
  </div>
</footer>
