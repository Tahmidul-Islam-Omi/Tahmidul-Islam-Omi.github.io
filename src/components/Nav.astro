---
import Icon from "./Icon.astro";
import { SITE, NAV_LINKS } from "../config";

const onHomePage = Astro.url.pathname === "/";
const sectionHref = (href: string) => onHomePage ? href : `/${href}`;
---

<header
  class="fixed inset-x-0 top-0 z-40 border-b border-[var(--border)] bg-[var(--bg)]/80 backdrop-blur-md"
>
  <nav
    class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6"
    aria-label="Primary"
  >
    <!-- Logo / name -->
    <a
      href={sectionHref("#top")}
      class="font-mono text-sm font-semibold tracking-tight text-[var(--text)] transition-colors hover:text-[var(--accent-text)]"
    >
      <span class="text-[var(--accent-text)]">&gt;</span>
      {SITE.name}
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-7 md:flex">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={sectionHref(link.href)}
              class="text-sm text-[var(--text-muted)] transition-colors hover:text-[var(--text)]"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        type="button"
        class="grid size-9 place-items-center rounded-lg text-[var(--text-muted)] transition-colors hover:bg-[var(--bg-subtle)] hover:text-[var(--text)]"
        aria-label="Toggle color theme"
      >
        <!-- Sun (shown in dark mode) -->
        <Icon name="sun" class="hidden size-5 dark:block" />
        <!-- Moon (shown in light mode) -->
        <Icon name="moon" class="size-5 dark:hidden" />
      </button>

      <!-- Mobile menu button -->
      <button
        id="menu-toggle"
        type="button"
        class="grid size-9 place-items-center rounded-lg text-[var(--text-muted)] transition-colors hover:bg-[var(--bg-subtle)] hover:text-[var(--text)] md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" class="size-5" />
      </button>
    </div>
  </nav>

  <!-- Mobile menu (collapsed by default) -->
  <div
    id="mobile-menu"
    class="hidden border-t border-[var(--border)] bg-[var(--bg)] md:hidden"
  >
    <ul class="mx-auto flex max-w-5xl flex-col px-6 py-3">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={sectionHref(link.href)}
              class="block py-2.5 text-sm text-[var(--text-muted)] transition-colors hover:text-[var(--text)]"
              data-mobile-link
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script is:inline>
  // Theme toggle — persists choice to localStorage.
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });

  // Mobile menu open/close.
  const menuBtn = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  menuBtn?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    menuBtn.setAttribute("aria-expanded", String(open));
  });
  // Close the menu after tapping a link.
  document.querySelectorAll("[data-mobile-link]").forEach((a) =>
    a.addEventListener("click", () => {
      menu?.classList.add("hidden");
      menuBtn?.setAttribute("aria-expanded", "false");
    }),
  );
</script>
